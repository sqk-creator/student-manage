/* score-rank-bar 等级划分条样式，全部单位 rpx（750 设计稿） */

.sr-bar-wrap {
  width: 100%;
  box-sizing: border-box;
}

/* 指示器区：等级标签 + 倒三角，与色条同宽，left 与三角 left 对齐 */
.sr-ind {
  position: relative;
  height: 70rpx;
  margin-bottom: 8rpx;
}

/* 等级标签：沿用现有 score-level 配色，圆角 12rpx */
.sr-tag {
  position: absolute;
  top: 0;
  padding: 8rpx 22rpx;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.3;
  border-radius: 12rpx;
  white-space: nowrap;
}

.level-excellent {
  background: rgba(20, 168, 154, 0.1);
  color: #14A89A;
}

.level-good {
  background: rgba(20, 168, 154, 0.08);
  color: #0B6D55;
}

.level-pass {
  background: rgba(255, 143, 90, 0.08);
  color: #FF8F5A;
}

.level-fail {
  background: rgba(255, 92, 74, 0.08);
  color: #FF5C4A;
}

/* 灰色倒三角：宽 32rpx 高 20rpx，尖角向下指向色条 */
.sr-tri {
  position: absolute;
  top: 50rpx;
  width: 0;
  height: 0;
  border-left: 16rpx solid transparent;
  border-right: 16rpx solid transparent;
  border-top: 20rpx solid #C0C4CC;
}

/* 色条：总高 80rpx，整体圆角 20rpx，4 色块 flex 等分铺满 */
.sr-bar {
  display: flex;
  width: 100%;
  height: 80rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.sr-seg {
  flex: 1;
  height: 100%;
}

.seg-fail {
  background: #E64340;
}

.seg-pass {
  background: #FF9500;
}

.seg-good {
  background: #FBBC05;
}

.seg-excellent {
  background: #14A89A;
}
