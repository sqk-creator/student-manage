.page {
  min-height: 100vh;
}

.page-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: #FFFFFF;
  padding: 0 32rpx;
}

.header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
  position: relative;
}

.back-btn {
  width: 63rpx;
  height: 63rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  flex-shrink: 0;
  margin-left: -10rpx;
}

.back-arrow {
  font-size: 38rpx;
  color: #333333;
  line-height: 1;
}

.header-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 0 24rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #1A1A1A;
  line-height: 1.2;
}

.grade-select,
.grade-select-text,
.grade-select-arrow {
  display: none;
}

.main-tabs {
  display: flex;
}

.main-tab {
  flex: 1;
  padding: 20rpx 10rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 400;
  color: #909399;
  position: relative;
}

.main-tab.active {
  color: #1A1A1A;
  font-weight: 600;
}

.main-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #14A89A;
}

.type-switch {
  display: flex;
  gap: 0;
  background: #F0F8F6;
  border-radius: 16rpx;
  padding: 4rpx;
  margin: 24rpx 32rpx 0;
}

.type-btn {
  flex: 1;
  padding: 14rpx 18rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 500;
  border-radius: 12rpx;
  color: #909399;
  background: transparent;
}

.type-btn.active {
  background: #14A89A;
  color: #FFFFFF;
  font-weight: 600;
}

.tab-content {
  padding: 32rpx;
}

.loading {
  text-align: center;
  padding: 70rpx;
  color: #909399;
  font-size: 24rpx;
}

.empty-state {
  text-align: center;
  padding: 105rpx 35rpx;
  color: #909399;
  font-size: 24rpx;
}

.empty-icon {
  font-size: 70rpx;
  margin-bottom: 21rpx;
  opacity: 0.4;
}

/* 吸顶容器：与 .page-header 一致的吸顶行为；不设 margin-top。
   上边框线为浅灰（仅顶边），作为与上方 page-header 的分隔，其余边框线不展示 */
.class-info-bar {
  position: sticky;
  top: 0;
  z-index: 90;
  background: #FFFFFF;
  border-top: 1rpx solid #E5E8EB;
}

.class-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  padding: 24rpx 64rpx;
  border-radius: 0; /* 直角，贴住 page-header 下方 */
}

.class-info-left {
  display: flex;
  align-items: center;
  min-width: 0;
}

.class-info-name {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #1A1A1A;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.class-info-tag {
  font-size: 22rpx;
  color: #14A89A;
  background: #E6F7F5;
  border-radius: 12rpx;
  padding: 4rpx 14rpx;
  font-weight: 500;
}

.class-info-right {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.ci-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  overflow: hidden;
  background: linear-gradient(135deg, #33B8AA, #33B8AA);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-weight: 700;
  font-size: 28rpx;
  border: 2rpx solid #FFFFFF; /* 描边，突出圆形重叠 */
  position: relative;
}

/* 后续头像向左重叠，形成堆叠效果 */
.ci-avatar + .ci-avatar {
  margin-left: -24rpx;
}

.ci-avatar-img {
  width: 100%;
  height: 100%;
}

/* 人数取值字号 32rpx、字重 600，与"人"单位区分开，位于箭头左侧 */
.ci-count-num {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-left: 6rpx;
  line-height: 1;
}

.ci-count-unit {
  font-size: 24rpx;
  color: #909399;
  margin-left: 4rpx;
}

.ci-arrow {
  font-size: 24rpx;
  color: #909399;
  margin-left: 12rpx;
}

.class-stats-card {
  padding-top: 32rpx; /* 与 padding-left 保持一致 */
}

.cs-rate {
  text-align: left;
}

.cs-rate-label {
  font-size: 26rpx;
  color: #333333;
  font-weight: 500;
}

.cs-rate-value {
  font-size: 88rpx;
  font-weight: 800;
  color: #14A89A;
  line-height: 1;
  margin-top: 8rpx;
}

.cs-rate-value .cs-rate-unit {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
}

.cs-rate-value.grade-c {
  color: #14A89A;
}

.gauge-stats {
  display: flex;
  gap: 24rpx;
  margin: 32rpx 0 36rpx; /* margin-bottom 与看年级页 .gauge-stats 保持一致 */
}

.gauge-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  background: #F0F8F6;
  border-radius: 16rpx;
  padding: 20rpx 12rpx;
}

.gauge-stat-label {
  font-size: 24rpx;
  color: #909399;
  font-weight: 500;
}

.gauge-stat-value {
  font-size: 40rpx;
  font-weight: 800;
  color: #1A1A1A;
  line-height: 1.1;
}

.subject-toggle {
  display: flex;
  flex-wrap: nowrap;
  gap: 12rpx;
  white-space: nowrap;
  width: 100%;
}

.subj-btn {
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  border: 1rpx solid #E6F7F5;
  background: #F7F9F9;
  color: #666666;
  flex-shrink: 0;
  white-space: nowrap;
}

.subj-btn.active {
  background: #14A89A;
  color: #FFFFFF;
  border-color: #14A89A;
  font-weight: 600;
}

.trend-canvas {
  width: 100%;
  height: 400rpx;
  margin-top: 20rpx;
  display: block;
}

.dist-card {
  padding-top: 32rpx; /* 与 padding-left 保持一致 */
}

.dist-rate {
  margin-bottom: 8rpx;
}

.dist-rate-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx 12rpx;
  margin: 28rpx 0 8rpx;
}

.dist-rate-grid .gauge-stat {
  width: calc(50% - 6rpx);
  flex: none;
  align-items: flex-start;
  text-align: left;
  gap: 6rpx;
  padding: 18rpx 24rpx;
}

.dist-stat {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
  font-size: 44rpx;
}

.dist-stat.fail text:first-child {
  color: #F75F5C;
}

.dist-rate-unit {
  font-size: 24rpx;
  font-weight: 600;
  color: #909399;
}

.hist-canvas {
  width: 100%;
  height: 400rpx; /* 与折线图 trend-canvas 高度保持一致 */
  margin-top: 8rpx;
  display: block;
}

.dist-eval {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-top: 28rpx;
  padding: 24rpx 28rpx;
  background: linear-gradient(90deg, #E6F7F5, #FFFFFF);
  border-radius: 20rpx;
  overflow: hidden;
}

.eval-badge {
  display: inline-block;
  padding: 6rpx 20rpx;
  background: #14A89A;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  border-radius: 24rpx 0 24rpx 0;
}

.dist-eval-text {
  padding: 12rpx 0 0;
  font-size: 30rpx;
  line-height: 1.6;
  text-align: left;
  font-weight: 700;
}

.dist-eval-note {
  color: #909399;
  font-size: 24rpx;
  margin-top: 8rpx;
}

.radar-card {
  padding-top: 28rpx;
}

.radar-card-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 20rpx;
}

.radar-top {
  display: flex;
  justify-content: flex-start;
  margin-bottom: 20rpx;
}

.radar-eval-badge {
  font-size: 24rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: linear-gradient(135deg, #14A89A, #33B8AA);
  border-radius: 16rpx;
  padding: 8rpx 24rpx;
  letter-spacing: 2rpx;
}

.radar-stats {
  display: flex;
  gap: 24rpx;
  margin-bottom: 12rpx;
}

.radar-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.radar-stat-label {
  font-size: 24rpx;
  color: #909399;
  font-weight: 500;
}

.radar-stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #1A1A1A;
  line-height: 1.1;
}

.radar-canvas {
  width: 100%;
  height: 600rpx;
  display: block;
}

.class-leaderboard {
  padding-top: 28rpx;
}

.class-leaderboard-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 24rpx;
}

.cb-card {
  display: flex;
  align-items: stretch;
  background: #F7FCFB;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
}

.cb-card:active {
  opacity: 0.8;
}

.cb-rank {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  margin-right: 36rpx;
}

.cb-rank-num {
  font-size: 64rpx;
  font-weight: 700;
  font-style: italic;
  opacity: 0.2;
  color: #14A89A;
  line-height: 1;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue',
    Arial, sans-serif;
}

.cb-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.cb-name-line {
  display: flex;
  align-items: center;
  min-width: 0;
}

.cb-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  margin-right: 16rpx;
  background: linear-gradient(135deg, #33B8AA, #33B8AA);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-weight: 700;
  font-size: 26rpx;
}

.cb-avatar-img {
  width: 100%;
  height: 100%;
}

.cb-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.cb-scores {
  display: flex;
  align-items: flex-end;
  gap: 20rpx;
  margin-top: 12rpx;
}

.cb-avg {
  font-size: 48rpx;
  font-weight: 600;
  color: #1A1A1A;
  line-height: 1;
}

.cr-change {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.change-val {
  font-size: 28rpx;
  font-weight: 700;
}

.change-val.up {
  color: #14A89A;
}

.change-val.down {
  color: #F75F5C;
}

.change-val.zero {
  color: #909399;
}

.change-arrow {
  font-size: 24rpx;
  line-height: 1;
}

.change-arrow.up {
  color: #14A89A;
}

.change-arrow.down {
  color: #F75F5C;
}

.cb-side {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: center;
  margin-left: 24rpx;
}

.cb-spark {
  width: 220rpx;
  height: 80rpx;
}
