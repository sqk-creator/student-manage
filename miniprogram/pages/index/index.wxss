.page {
  min-height: 100vh;
}

.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 32rpx 24rpx;
}

.left-group {
  display: flex;
  align-items: center;
}

.avatar {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #33B8AA, #14A89A);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.username {
  font-size: 30rpx;
  font-weight: 500;
  color: #333333;
  margin-left: 16rpx;
}

.nickname {
  font-size: 24rpx;
  color: #14A89A;
  background: #E6F7F5;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  margin-left: 12rpx;
}

.banner {
  margin: 0 32rpx;
  border-radius: 24rpx;
  position: relative;
  overflow: hidden;
}

.banner-swiper {
  height: 279rpx;
}

.banner-slide-img {
  width: 100%;
  height: 279rpx;
  border-radius: 24rpx;
  display: block;
}

.banner-fallback {
  padding: 35rpx 31rpx;
  background: linear-gradient(135deg, #14A89A 0%, #33B8AA 100%);
  position: relative;
  overflow: hidden;
}

.banner-fallback::before {
  content: '';
  position: absolute;
  top: -30%;
  right: -20%;
  width: 315rpx;
  height: 315rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.15) 0%, transparent 70%);
  border-radius: 50%;
}

.banner-content {
  position: relative;
  z-index: 1;
}

.banner-illustration {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  margin-bottom: 24rpx;
  gap: 14rpx;
  min-height: 98rpx;
}

.illus-book {
  width: 63rpx;
  height: 49rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0.7));
  border-radius: 10rpx 10rpx 0 0;
  position: relative;
}

.illus-book-tri {
  position: absolute;
  top: -21rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 12rpx solid transparent;
  border-right: 12rpx solid transparent;
  border-bottom: 21rpx solid rgba(255, 255, 255, 0.9);
}

.illus-people {
  display: flex;
  gap: 5rpx;
  align-items: flex-end;
}

.illus-person {
  width: 12rpx;
  height: 35rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.8), rgba(255, 255, 255, 0.5));
  border-radius: 7rpx 7rpx 0 0;
}

.illus-person.tall {
  height: 45rpx;
}

.illus-person.med {
  height: 35rpx;
}

.banner-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #FFFFFF;
  text-align: center;
  margin-bottom: 10rpx;
}

.banner-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  text-align: center;
}

.banner-dots {
  display: flex;
  justify-content: center;
  gap: 10rpx;
  position: absolute;
  bottom: 21rpx;
  left: 0;
  right: 0;
  z-index: 2;
}

.banner-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.5);
  transition: all 0.3s;
}

.banner-dot.active {
  background: #FFFFFF;
  width: 31rpx;
  border-radius: 5rpx;
}

.quick-actions {
  display: flex;
  padding: 40rpx 32rpx 0;
}

.action-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 8rpx 0;
  position: relative;
}

.action-icon {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.action-img {
  width: 96rpx;
  height: 96rpx;
}

.action-label {
  font-size: 26rpx;
  color: #333333;
  font-weight: 500;
}

.badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 36rpx;
  height: 36rpx;
  background: #EE0A24;
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 10rpx;
  z-index: 2;
}

.feature-zone {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  padding: 0 32rpx;
  margin: 40rpx 0;
}

.feature-left {
  grid-row: span 2;
  height: 335rpx;
  background: linear-gradient(135deg, #14A89A 0%, #33B8AA 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  position: relative;
  overflow: hidden;
}

.feature-left::before {
  content: '';
  position: absolute;
  top: -20%;
  right: -20%;
  width: 280rpx;
  height: 280rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.12) 0%, transparent 70%);
  border-radius: 50%;
}

.feature-left-head {
  position: relative;
  z-index: 1;
}

.feature-left-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #FFFFFF;
  position: relative;
  z-index: 1;
}

.feature-left-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 12rpx;
  position: relative;
  z-index: 1;
}

.feature-left-btn {
  align-self: flex-start;
  padding: 12rpx 24rpx;
  background: #FFFFFF;
  color: #14A89A;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  position: relative;
  z-index: 1;
}

.feature-right {
  background: #E6F7F5;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(20, 168, 154, 0.08);
  position: relative;
  overflow: hidden;
}

.feature-right-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333333;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.feature-right-sub {
  font-size: 24rpx;
  color: #909399;
  margin-top: 12rpx;
}

.feature-dot {
  width: 12rpx;
  height: 12rpx;
  background: #EE0A24;
  border-radius: 50%;
}

.my-classes {
  padding: 0 32rpx 40rpx;
}

.section-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 24rpx;
}

.empty-tip {
  text-align: center;
  padding: 40rpx 0;
  color: #909399;
  font-size: 24rpx;
}

.class-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(20, 168, 154, 0.08);
}

.class-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.class-name-group {
  display: flex;
  align-items: center;
}

.class-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333333;
}

.class-tag {
  font-size: 24rpx;
  color: #14A89A;
  background: #E6F7F5;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  margin-left: 12rpx;
}

.arrow-icon {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #909399;
  font-size: 40rpx;
  line-height: 1;
}

.class-stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8rpx;
}

.stat-item {
  text-align: center;
}

.stat-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.stat-unit {
  font-size: 24rpx;
  font-weight: 400;
  color: #909399;
  margin-left: 2rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #909399;
  margin-top: 4rpx;
}
