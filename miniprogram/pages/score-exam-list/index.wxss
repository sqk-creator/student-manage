.page {
  min-height: 100vh;
}

.page-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: #FFFFFF;
  padding: 0 32rpx;
}

.header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
  position: relative;
}

.back-btn {
  width: 63rpx;
  height: 63rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  flex-shrink: 0;
  margin-left: -10rpx;
}

.back-arrow {
  font-size: 38rpx;
  color: #333333;
  line-height: 1;
}

.header-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 0 24rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #1A1A1A;
  line-height: 1.2;
}

.grade-picker {
  flex-shrink: 0;
  margin-left: auto;
}

.grade-select {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  border-radius: 16rpx;
  background: #F0F8F6;
}

.grade-select-text {
  font-size: 26rpx;
  font-weight: 400;
  color: #909399;
}

.grade-select-arrow {
  font-size: 18rpx;
  color: #909399;
  margin-top: -4rpx;
}

.main-tabs {
  display: flex;
}

.main-tab {
  flex: 1;
  padding: 20rpx 10rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 400;
  color: #909399;
  position: relative;
}

.main-tab.active {
  color: #1A1A1A;
  font-weight: 600;
}

.main-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #14A89A;
}

.exam-filter-row {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  padding: 32rpx 32rpx 0;
  justify-content: center;
}

.sub-tab-wrap {
  display: inline-flex;
  background: #F0F8F6;
  border-radius: 20rpx;
  padding: 4rpx;
  flex-shrink: 0;
}

.sub-tab {
  padding: 14rpx 40rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: #909399;
  transition: all 0.2s;
}

.sub-tab.active {
  background: #14A89A;
  color: #FFFFFF;
  font-weight: 600;
}

.tab-content {
  padding: 32rpx;
}

.empty-state {
  text-align: center;
  padding: 105rpx 35rpx;
  color: #909399;
  font-size: 24rpx;
}

.empty-icon {
  font-size: 70rpx;
  margin-bottom: 21rpx;
  opacity: 0.4;
}

.loading {
  text-align: center;
  padding: 70rpx;
  color: #909399;
  font-size: 24rpx;
}

.group-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(20, 168, 154, 0.08);
}

/* —— 年级统考（group）卡片：标签置顶材质 —— */
.group-card.group-exam {
  padding-top: 0; /* 顶部贴住卡片 group-card 上边缘 */
}

.card-top-tags {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 22rpx;
}

.tag-grade {
  font-size: 7rpx;
  line-height: 1.2;
  font-weight: 600;
  color: #14A89A;
  background: rgba(20, 168, 154, 0.10);
  padding: 8rpx 20rpx;
  border-radius: 0 0 10rpx 10rpx; /* 左上、右上角为直角 */
  white-space: nowrap;
}

.tag-type {
  font-size: 7rpx;
  line-height: 1.2;
  font-weight: 600;
  color: #86909C;
  background: #F2F3F5;
  padding: 8rpx 20rpx;
  border-radius: 0 0 10rpx 10rpx; /* 左上、右上角为直角 */
  white-space: nowrap;
}

.card-title-wrap {
  margin-bottom: 4rpx;
}

.group-card.group-exam .card-title {
  font-size: 38rpx; /* 考试标题适当放大 */
}

.card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333333;
}

.card-grade {
  font-size: 24rpx;
  color: #14A89A;
  white-space: nowrap;
}

.card-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  margin-bottom: 24rpx;
}

.card-meta text + text::before {
  content: '|';
  margin: 0 12rpx;
  color: #D8DCE0;
}

.meta-tag {
  font-size: 24rpx;
  color: #909399;
}

.card-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.stat-item {
  text-align: center;
  background: #F0F8F6;
  border-radius: 16rpx;
  padding: 20rpx 12rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #909399;
}

.stat-value {
  font-size: 64rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-top: 4rpx;
}

.stat-percent {
  font-size: 32rpx;
  font-weight: 700;
}

.stat-value.green {
  color: #14A89A;
}

.card-actions {
  display: flex;
  gap: 24rpx;
}

.card-btn {
  flex: 1;
  padding: 20rpx 0;
  border-radius: 16rpx;
  font-size: 8rpx;
  font-weight: 500;
  text-align: center;
}

.btn-outline {
  background: #E6F7F5;
  color: #14A89A;
}

.btn-outline:active {
  background: #D8EFEC;
}

.btn-primary {
  background: #14A89A;
  color: #FFFFFF;
}

.btn-primary:active {
  background: #0F8478;
}
